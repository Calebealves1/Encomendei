rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Primitives & Helpers
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function isValidSlug(slug) {
      return slug is string
        && slug.size() >= 3
        && slug.size() <= 40
        && slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$')
        && !(slug in ['login', 'cadastro', 'painel', 'api', 'admin', 'recuperar-senha', 'privacidade', 'termos', 'config', 'a']);
    }

    function isValidMes(mes) {
      return mes is string && mes.size() == 7 && mes.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // ---------------------------------------------------------
    // Validation Blueprints
    // ---------------------------------------------------------
    function isValidArtesao(data, uid) {
      return data.keys().hasAll([
          'uid', 'nomeAtelie', 'nomeResponsavel', 'email',
          'plano', 'aceitandoPedidos', 'uso', 'mesReferencia',
          'criadoEm', 'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'uid', 'nomeAtelie', 'nomeResponsavel', 'email',
          'telefone', 'cidadeUf', 'especialidade', 'bio', 'slug',
          'valorHoraPadrao', 'margemPadrao', 'taxaPlataformaPadrao', 'percentualIndiretoPadrao',
          'plano', 'aceitandoPedidos', 'uso', 'mesReferencia',
          'criadoEm', 'atualizadoEm'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == uid
        && data.nomeAtelie is string && data.nomeAtelie.size() >= 2 && data.nomeAtelie.size() <= 80
        && data.nomeResponsavel is string && data.nomeResponsavel.size() >= 2 && data.nomeResponsavel.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && (!('telefone' in data) || (data.telefone is string && data.telefone.size() <= 30))
        && (!('cidadeUf' in data) || (data.cidadeUf is string && data.cidadeUf.size() <= 60))
        && (!('especialidade' in data) || (data.especialidade is string && data.especialidade.size() <= 60))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 600))
        && (!('slug' in data) || (data.slug is string && data.slug.size() <= 40 && (data.slug == '' || isValidSlug(data.slug))))
        && (!('valorHoraPadrao' in data) || (data.valorHoraPadrao is number && data.valorHoraPadrao >= 0 && data.valorHoraPadrao <= 10000))
        && (!('margemPadrao' in data) || (data.margemPadrao is number && data.margemPadrao >= 0 && data.margemPadrao <= 300))
        && (!('taxaPlataformaPadrao' in data) || (data.taxaPlataformaPadrao is number && data.taxaPlataformaPadrao >= 0 && data.taxaPlataformaPadrao <= 50))
        && (!('percentualIndiretoPadrao' in data) || (data.percentualIndiretoPadrao is number && data.percentualIndiretoPadrao >= 0 && data.percentualIndiretoPadrao <= 100))
        && data.plano is string && data.plano.size() <= 20 && data.plano in ['gratuito', 'atelie', 'mestre']
        && data.aceitandoPedidos is bool
        && data.uso is number && data.uso >= 0 && data.uso <= 1000000
        && isValidMes(data.mesReferencia)
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    function isValidPerfilPublico(data, uid) {
      return data.keys().hasAll([
          'uid', 'slug', 'nomeAtelie', 'especialidade',
          'prazoMedioDias', 'aceitandoPedidos', 'ativo',
          'corDestaque', 'categorias', 'criadoEm', 'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'uid', 'slug', 'nomeAtelie', 'especialidade', 'cidadeUf', 'bio',
          'prazoMedioDias', 'aceitandoPedidos', 'ativo',
          'corDestaque', 'categorias', 'criadoEm', 'atualizadoEm'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == uid
        && isValidSlug(data.slug)
        && data.nomeAtelie is string && data.nomeAtelie.size() >= 2 && data.nomeAtelie.size() <= 80
        && data.especialidade is string && data.especialidade.size() >= 2 && data.especialidade.size() <= 60
        && (!('cidadeUf' in data) || (data.cidadeUf is string && data.cidadeUf.size() <= 60))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 600))
        && data.prazoMedioDias is number && data.prazoMedioDias >= 1 && data.prazoMedioDias <= 365
        && data.aceitandoPedidos is bool
        && data.ativo is bool
        && data.corDestaque is string && data.corDestaque.size() == 7 && data.corDestaque in ['#D065D6', '#94D665', '#728168', '#2D254E']
        && data.categorias is list && data.categorias.size() <= 10
        && (data.categorias.size() == 0 || (data.categorias[0] is string && data.categorias[0].size() <= 40))
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    function isValidItemPortfolio(data, uid) {
      return data.keys().hasAll([
          'uid', 'titulo', 'categoria', 'tempoProducaoDias',
          'precoReferencia', 'imagemBase64', 'ordem', 'criadoEm', 'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'uid', 'titulo', 'categoria', 'descricao', 'tempoProducaoDias',
          'precoReferencia', 'imagemBase64', 'ordem', 'criadoEm', 'atualizadoEm'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == uid
        && data.titulo is string && data.titulo.size() >= 2 && data.titulo.size() <= 80
        && data.categoria is string && data.categoria.size() >= 2 && data.categoria.size() <= 40
        && (!('descricao' in data) || (data.descricao is string && data.descricao.size() <= 400))
        && data.tempoProducaoDias is number && data.tempoProducaoDias >= 1 && data.tempoProducaoDias <= 365
        && data.precoReferencia is number && data.precoReferencia >= 0 && data.precoReferencia <= 1000000
        && data.imagemBase64 is string && data.imagemBase64.size() <= 750000
        && data.ordem is number && data.ordem >= 0 && data.ordem <= 500
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    function isValidStatusTransition(fromStatus, toStatus) {
      return (fromStatus == 'Novo' && toStatus in ['Em Orçamento', 'Cancelado'])
        || (fromStatus == 'Em Orçamento' && toStatus in ['Aguardando Aprovação', 'Recusado', 'Cancelado'])
        || (fromStatus == 'Aguardando Aprovação' && toStatus in ['Aprovado', 'Em Orçamento', 'Recusado', 'Cancelado'])
        || (fromStatus == 'Aprovado' && toStatus in ['Em Produção', 'Cancelado'])
        || (fromStatus == 'Em Produção' && toStatus in ['Pronto', 'Cancelado'])
        || (fromStatus == 'Pronto' && toStatus in ['Entregue', 'Cancelado']);
    }

    function isTerminalStatus(st) {
      return st in ['Entregue', 'Recusado', 'Cancelado'];
    }

    function isValidOrcamentoAtual(orc) {
      return orc is map
        && orc.keys().hasAll(['versao', 'valorTotal', 'sinalEntrada', 'validadeDias', 'criadoEm'])
        && orc.keys().hasOnly(['versao', 'valorTotal', 'sinalEntrada', 'validadeDias', 'observacoes', 'criadoEm'])
        && orc.versao is number && orc.versao >= 1 && orc.versao <= 100
        && orc.valorTotal is number && orc.valorTotal >= 0 && orc.valorTotal <= 1000000
        && orc.sinalEntrada is number && orc.sinalEntrada >= 0 && orc.sinalEntrada <= 1000000
        && orc.validadeDias is number && orc.validadeDias >= 1 && orc.validadeDias <= 365
        && (!('observacoes' in orc) || (orc.observacoes is string && orc.observacoes.size() <= 1000))
        && orc.criadoEm is timestamp;
    }

    function isValidPedidoCreate(data, uid) {
      return data.keys().hasAll([
          'uidArtesao', 'codigo', 'clienteNome', 'clienteEmail', 'categoria',
          'titulo', 'descricao', 'status', 'consentimentoLgpd', 'consentimentoEm',
          'consentimentoVersao', 'totalImagens', 'criadoEm', 'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'uidArtesao', 'codigo', 'clienteNome', 'clienteEmail', 'clienteWhatsApp',
          'categoria', 'titulo', 'descricao', 'medidas', 'orcamentoClienteDesejado',
          'prazoDesejadoTexto', 'status', 'consentimentoLgpd', 'consentimentoEm',
          'consentimentoVersao', 'prazoEstimadoDias', 'dataEntregaPrevista',
          'notasInternas', 'orcamentoAtual', 'totalImagens', 'criadoEm', 'atualizadoEm', 'encerradoEm'
        ])
        && data.uidArtesao is string && data.uidArtesao.size() >= 1 && data.uidArtesao.size() <= 128 && data.uidArtesao == uid
        && data.codigo is string && data.codigo.size() >= 4 && data.codigo.size() <= 32
        && data.clienteNome is string && data.clienteNome.size() >= 2 && data.clienteNome.size() <= 100
        && data.clienteEmail is string && data.clienteEmail.size() >= 3 && data.clienteEmail.size() <= 120
        && (!('clienteWhatsApp' in data) || (data.clienteWhatsApp is string && data.clienteWhatsApp.size() <= 30))
        && data.categoria is string && data.categoria.size() >= 2 && data.categoria.size() <= 60
        && data.titulo is string && data.titulo.size() >= 3 && data.titulo.size() <= 120
        && data.descricao is string && data.descricao.size() >= 10 && data.descricao.size() <= 2000
        && (!('medidas' in data) || (data.medidas is string && data.medidas.size() <= 200))
        && (!('orcamentoClienteDesejado' in data) || data.orcamentoClienteDesejado == null || (data.orcamentoClienteDesejado is number && data.orcamentoClienteDesejado >= 0 && data.orcamentoClienteDesejado <= 1000000))
        && (!('prazoDesejadoTexto' in data) || (data.prazoDesejadoTexto is string && data.prazoDesejadoTexto.size() <= 80))
        && data.status is string && data.status.size() == 4 && data.status == 'Novo'
        && data.consentimentoLgpd is bool && data.consentimentoLgpd == true
        && data.consentimentoEm == request.time
        && data.consentimentoVersao is string && data.consentimentoVersao.size() <= 20 && data.consentimentoVersao == '1.0'
        && (!('prazoEstimadoDias' in data) || data.prazoEstimadoDias == null)
        && (!('dataEntregaPrevista' in data) || data.dataEntregaPrevista == null)
        && (!('notasInternas' in data) || (data.notasInternas is string && data.notasInternas.size() == 0))
        && (!('orcamentoAtual' in data) || data.orcamentoAtual == null)
        && (!('encerradoEm' in data) || data.encerradoEm == null)
        && data.totalImagens is number && data.totalImagens >= 0 && data.totalImagens <= 5
        && data.criadoEm == request.time
        && data.atualizadoEm == request.time;
    }

    function isValidImagemPedidoCreate(data) {
      return data.keys().hasAll(['nome', 'mimeType', 'tamanhoBytes', 'dataBase64', 'criadoEm'])
        && data.keys().hasOnly(['nome', 'mimeType', 'tamanhoBytes', 'dataBase64', 'criadoEm'])
        && data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 120
        && data.mimeType is string && data.mimeType.size() <= 30 && data.mimeType in ['image/jpeg', 'image/png', 'image/webp']
        && data.tamanhoBytes is number && data.tamanhoBytes > 0 && data.tamanhoBytes <= 512000
        && data.dataBase64 is string && data.dataBase64.size() >= 10 && data.dataBase64.size() <= 750000
        && data.criadoEm == request.time;
    }

    function isValidPedidoUpdateShape(data, uid) {
      return data.keys().hasAll([
          'uidArtesao', 'codigo', 'clienteNome', 'clienteEmail', 'categoria',
          'titulo', 'descricao', 'status', 'consentimentoLgpd', 'consentimentoEm',
          'consentimentoVersao', 'totalImagens', 'criadoEm', 'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'uidArtesao', 'codigo', 'clienteNome', 'clienteEmail', 'clienteWhatsApp',
          'categoria', 'titulo', 'descricao', 'medidas', 'orcamentoClienteDesejado',
          'prazoDesejadoTexto', 'status', 'consentimentoLgpd', 'consentimentoEm',
          'consentimentoVersao', 'prazoEstimadoDias', 'dataEntregaPrevista',
          'notasInternas', 'orcamentoAtual', 'totalImagens', 'criadoEm', 'atualizadoEm', 'encerradoEm'
        ])
        && data.uidArtesao is string && data.uidArtesao.size() <= 128 && data.uidArtesao == uid
        && data.status is string && data.status.size() <= 40
        && (!('notasInternas' in data) || (data.notasInternas is string && data.notasInternas.size() <= 1000))
        && (!('prazoEstimadoDias' in data) || data.prazoEstimadoDias == null || (data.prazoEstimadoDias is number && data.prazoEstimadoDias >= 1 && data.prazoEstimadoDias <= 365))
        && (!('dataEntregaPrevista' in data) || data.dataEntregaPrevista == null || (data.dataEntregaPrevista is string && data.dataEntregaPrevista.size() <= 20))
        && (!('orcamentoAtual' in data) || data.orcamentoAtual == null || isValidOrcamentoAtual(data.orcamentoAtual))
        && data.atualizadoEm == request.time;
    }

    function isValidOrcamentoVersao(data) {
      return data.keys().hasAll([
          'versao', 'custoMateriais', 'horasTrabalho', 'valorHora',
          'valorTotal', 'sinalEntrada', 'prazoEstimadoDias', 'validadeDias',
          'itensMateriais', 'criadoEm'
        ])
        && data.keys().hasOnly([
          'versao', 'custoMateriais', 'horasTrabalho', 'valorHora',
          'percentualIndireto', 'percentualMargem', 'percentualTaxa', 'descontoValor',
          'valorTotal', 'sinalEntrada', 'lucroLiquidoEstimado', 'prazoEstimadoDias',
          'validadeDias', 'observacoes', 'itensMateriais', 'criadoEm'
        ])
        && data.versao is number && data.versao >= 1 && data.versao <= 100
        && data.custoMateriais is number && data.custoMateriais >= 0 && data.custoMateriais <= 1000000
        && data.horasTrabalho is number && data.horasTrabalho >= 0 && data.horasTrabalho <= 10000
        && data.valorHora is number && data.valorHora >= 0 && data.valorHora <= 10000
        && (!('percentualIndireto' in data) || (data.percentualIndireto is number && data.percentualIndireto >= 0 && data.percentualIndireto <= 100))
        && (!('percentualMargem' in data) || (data.percentualMargem is number && data.percentualMargem >= 0 && data.percentualMargem <= 300))
        && (!('percentualTaxa' in data) || (data.percentualTaxa is number && data.percentualTaxa >= 0 && data.percentualTaxa <= 50))
        && (!('descontoValor' in data) || (data.descontoValor is number && data.descontoValor >= 0 && data.descontoValor <= 1000000))
        && data.valorTotal is number && data.valorTotal >= 0 && data.valorTotal <= 1000000
        && data.sinalEntrada is number && data.sinalEntrada >= 0 && data.sinalEntrada <= 1000000
        && (!('lucroLiquidoEstimado' in data) || (data.lucroLiquidoEstimado is number && data.lucroLiquidoEstimado >= -100000 && data.lucroLiquidoEstimado <= 1000000))
        && data.prazoEstimadoDias is number && data.prazoEstimadoDias >= 1 && data.prazoEstimadoDias <= 365
        && data.validadeDias is number && data.validadeDias >= 1 && data.validadeDias <= 365
        && (!('observacoes' in data) || (data.observacoes is string && data.observacoes.size() <= 1000))
        && data.itensMateriais is list && data.itensMateriais.size() <= 30
        && (data.itensMateriais.size() == 0 || data.itensMateriais[0] is map)
        && data.criadoEm == request.time;
    }

    function isValidHistoricoEvento(data) {
      return data.keys().hasAll(['tipo', 'descricao', 'autor', 'criadoEm'])
        && data.keys().hasOnly(['tipo', 'descricao', 'autor', 'criadoEm'])
        && data.tipo is string && data.tipo.size() <= 20 && data.tipo in ['criacao', 'status', 'orcamento', 'nota']
        && data.descricao is string && data.descricao.size() >= 1 && data.descricao.size() <= 300
        && data.autor is string && data.autor.size() <= 20 && data.autor in ['cliente', 'artesao', 'sistema']
        && data.criadoEm == request.time;
    }

    // ---------------------------------------------------------
    // Collection Rules
    // ---------------------------------------------------------

    // Config/planos: read-only
    match /config/planos {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Slugs: public read, owner create-only (never overwrite existing)
    match /slugs/{slug} {
      allow get: if isValidSlug(slug);
      allow list: if false;
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && isValidSlug(slug)
        && !exists(/databases/$(database)/documents/slugs/$(slug))
        && incoming().keys().hasAll(['uid', 'criadoEm'])
        && incoming().keys().hasOnly(['uid', 'criadoEm'])
        && incoming().uid is string && incoming().uid.size() <= 128 && incoming().uid == request.auth.uid
        && incoming().criadoEm == request.time;
      allow update: if false;
      allow delete: if isSignedIn()
        && request.auth.token.email_verified == true
        && isValidSlug(slug)
        && existing().uid == request.auth.uid;
    }

    // Perfis Públicos (sem PII): leitura pública, escrita pelo dono sem alterar aceitandoPedidos
    match /perfisPublicos/{uid} {
      allow get: if isValidId(uid) && (resource == null || resource.data.ativo == true || (isSignedIn() && request.auth.uid == uid));
      allow list: if resource.data.ativo == true || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(uid)
        && isVerifiedOwner(uid)
        && isValidPerfilPublico(incoming(), uid)
        && incoming().aceitandoPedidos == true
        && incoming().criadoEm == request.time
        && incoming().atualizadoEm == request.time
        && existsAfter(/databases/$(database)/documents/slugs/$(incoming().slug))
        && getAfter(/databases/$(database)/documents/slugs/$(incoming().slug)).data.uid == uid;
      allow update: if isValidId(uid)
        && isVerifiedOwner(uid)
        && isValidPerfilPublico(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().criadoEm == existing().criadoEm
        && incoming().atualizadoEm == request.time
        && incoming().aceitandoPedidos == existing().aceitandoPedidos
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'nomeAtelie', 'especialidade', 'cidadeUf', 'bio',
          'prazoMedioDias', 'ativo', 'corDestaque', 'categorias', 'atualizadoEm'
        ])
        && existsAfter(/databases/$(database)/documents/slugs/$(incoming().slug))
        && getAfter(/databases/$(database)/documents/slugs/$(incoming().slug)).data.uid == uid;
      allow delete: if isValidId(uid) && isVerifiedOwner(uid);

      match /portfolio/{itemId} {
        allow get: if isValidId(uid) && isValidId(itemId);
        allow list: if resource.data.uid == uid;
        allow create: if isValidId(uid)
          && isValidId(itemId)
          && isVerifiedOwner(uid)
          && exists(/databases/$(database)/documents/perfisPublicos/$(uid))
          && isValidItemPortfolio(incoming(), uid)
          && incoming().criadoEm == request.time
          && incoming().atualizadoEm == request.time;
        allow update: if isValidId(uid)
          && isValidId(itemId)
          && isVerifiedOwner(uid)
          && isValidItemPortfolio(incoming(), uid)
          && incoming().uid == existing().uid
          && incoming().criadoEm == existing().criadoEm
          && incoming().atualizadoEm == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'titulo', 'categoria', 'descricao', 'tempoProducaoDias',
            'precoReferencia', 'imagemBase64', 'ordem', 'atualizadoEm'
          ]);
        allow delete: if isValidId(uid) && isValidId(itemId) && isVerifiedOwner(uid);
      }
    }

    // Artesãos (dados privados e cota protegida)
    match /artesaos/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isValidId(uid)
        && isVerifiedOwner(uid)
        && isValidArtesao(incoming(), uid)
        && incoming().plano == 'gratuito'
        && incoming().aceitandoPedidos == true
        && incoming().uso == 0
        && incoming().criadoEm == request.time
        && incoming().atualizadoEm == request.time;
      allow update: if isValidId(uid)
        && isVerifiedOwner(uid)
        && isValidArtesao(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().criadoEm == existing().criadoEm
        && incoming().atualizadoEm == request.time
        // Campos protegidos que o artesão NÃO pode alterar pelo cliente:
        && incoming().plano == existing().plano
        && incoming().aceitandoPedidos == existing().aceitandoPedidos
        && incoming().uso == existing().uso
        && incoming().mesReferencia == existing().mesReferencia
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nomeAtelie', 'nomeResponsavel', 'email', 'telefone', 'cidadeUf',
          'especialidade', 'bio', 'slug', 'valorHoraPadrao', 'margemPadrao',
          'taxaPlataformaPadrao', 'percentualIndiretoPadrao', 'atualizadoEm'
        ]);
      allow delete: if isValidId(uid) && isVerifiedOwner(uid);

      // Uso mensal: somente leitura pelo dono (exclusão permitida apenas durante encerramento da conta)
      match /uso/{mesId} {
        allow get: if isValidId(uid) && isValidMes(mesId) && isSignedIn() && request.auth.uid == uid;
        allow list: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if false;
        allow delete: if isValidId(uid) && isValidMes(mesId) && isVerifiedOwner(uid)
          && !exists(/databases/$(database)/documents/artesaos/$(uid));
      }

      // Pedidos: criação pública validada (LGPD + vitrine ativa) e leitura/gestão exclusiva pelo dono
      match /pedidos/{pedidoId} {
        allow get: if isValidId(uid) && isValidId(pedidoId) && isSignedIn() && request.auth.uid == uid;
        allow list: if isSignedIn() && request.auth.uid == uid;
        allow create: if isValidId(uid)
          && isValidId(pedidoId)
          && isValidPedidoCreate(incoming(), uid)
          && exists(/databases/$(database)/documents/perfisPublicos/$(uid))
          && get(/databases/$(database)/documents/perfisPublicos/$(uid)).data.ativo == true
          && get(/databases/$(database)/documents/perfisPublicos/$(uid)).data.aceitandoPedidos == true;
        allow delete: if isValidId(uid) && isValidId(pedidoId) && isVerifiedOwner(uid)
          && !exists(/databases/$(database)/documents/artesaos/$(uid));

        allow update: if isValidId(uid)
          && isValidId(pedidoId)
          && isVerifiedOwner(uid)
          && isValidPedidoUpdateShape(incoming(), uid)
          && incoming().uidArtesao == existing().uidArtesao
          && incoming().codigo == existing().codigo
          && incoming().categoria == existing().categoria
          && incoming().titulo == existing().titulo
          && incoming().descricao == existing().descricao
          && incoming().consentimentoLgpd == existing().consentimentoLgpd
          && incoming().consentimentoEm == existing().consentimentoEm
          && incoming().consentimentoVersao == existing().consentimentoVersao
          && incoming().criadoEm == existing().criadoEm
          && (
            (
              !isTerminalStatus(existing().status)
              && incoming().clienteNome == existing().clienteNome
              && incoming().clienteEmail == existing().clienteEmail
              && incoming().totalImagens == existing().totalImagens
              && (
                // Ação 1: Mudança de status no Kanban (RN04)
                (
                  isValidStatusTransition(existing().status, incoming().status)
                  && (
                    (isTerminalStatus(incoming().status) && incoming().encerradoEm == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'atualizadoEm', 'encerradoEm']))
                    || (!isTerminalStatus(incoming().status) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'atualizadoEm']))
                  )
                )
                // Ação 2: Atualização de orçamento, prazo ou notas internas (mantendo status)
                || (
                  incoming().status == existing().status
                  && incoming().diff(existing()).affectedKeys().hasOnly(['orcamentoAtual', 'prazoEstimadoDias', 'dataEntregaPrevista', 'notasInternas', 'atualizadoEm'])
                )
                // Ação 3: Salvar orçamento e avançar para Aguardando Aprovação (RN04 + RN07)
                || (
                  isValidStatusTransition(existing().status, incoming().status)
                  && !isTerminalStatus(incoming().status)
                  && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'orcamentoAtual', 'prazoEstimadoDias', 'dataEntregaPrevista', 'atualizadoEm'])
                )
              )
            )
            // Ação 4: Expurgo LGPD após 12 meses de encerramento (RN10)
            || (
              isTerminalStatus(existing().status)
              && existing().encerradoEm is timestamp
              && request.time >= existing().encerradoEm + duration.value(365, 'd')
              && incoming().clienteNome == 'Dados expurgados (LGPD)'
              && incoming().clienteEmail == 'expurgado@lgpd.local'
              && incoming().clienteWhatsApp == ''
              && incoming().notasInternas == ''
              && incoming().totalImagens == 0
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'clienteNome', 'clienteEmail', 'clienteWhatsApp', 'notasInternas', 'totalImagens', 'atualizadoEm'
              ])
            )
          );

        match /imagens/{imagemId} {
          allow get: if isValidId(uid) && isValidId(pedidoId) && isValidId(imagemId) && isSignedIn() && request.auth.uid == uid;
          allow list: if isSignedIn() && request.auth.uid == uid;
          allow create: if isValidId(uid)
            && isValidId(pedidoId)
            && isValidId(imagemId)
            && isValidImagemPedidoCreate(incoming())
            && existsAfter(/databases/$(database)/documents/artesaos/$(uid)/pedidos/$(pedidoId))
            && getAfter(/databases/$(database)/documents/artesaos/$(uid)/pedidos/$(pedidoId)).data.criadoEm == request.time;
          allow update: if false;
          allow delete: if isValidId(uid) && isValidId(pedidoId) && isValidId(imagemId)
            && isVerifiedOwner(uid)
            && (
              !exists(/databases/$(database)/documents/artesaos/$(uid))
              || (
                exists(/databases/$(database)/documents/artesaos/$(uid)/pedidos/$(pedidoId))
                && isTerminalStatus(get(/databases/$(database)/documents/artesaos/$(uid)/pedidos/$(pedidoId)).data.status)
                && get(/databases/$(database)/documents/artesaos/$(uid)/pedidos/$(pedidoId)).data.encerradoEm is timestamp
                && request.time >= get(/databases/$(database)/documents/artesaos/$(uid)/pedidos/$(pedidoId)).data.encerradoEm + duration.value(365, 'd')
              )
            );
        }

        match /orcamentos/{orcamentoId} {
          allow get: if isValidId(uid) && isValidId(pedidoId) && isValidId(orcamentoId) && isSignedIn() && request.auth.uid == uid;
          allow list: if isSignedIn() && request.auth.uid == uid;
          allow create: if isValidId(uid)
            && isValidId(pedidoId)
            && isValidId(orcamentoId)
            && isVerifiedOwner(uid)
            && exists(/databases/$(database)/documents/artesaos/$(uid)/pedidos/$(pedidoId))
            && isValidOrcamentoVersao(incoming());
          allow update: if false;
          allow delete: if isValidId(uid) && isValidId(pedidoId) && isValidId(orcamentoId)
            && isVerifiedOwner(uid)
            && !exists(/databases/$(database)/documents/artesaos/$(uid));
        }

        match /historico/{eventoId} {
          allow get: if isValidId(uid) && isValidId(pedidoId) && isValidId(eventoId) && isSignedIn() && request.auth.uid == uid;
          allow list: if isSignedIn() && request.auth.uid == uid;
          allow create: if isValidId(uid)
            && isValidId(pedidoId)
            && isValidId(eventoId)
            && isValidHistoricoEvento(incoming())
            && (
              (
                isVerifiedOwner(uid)
                && exists(/databases/$(database)/documents/artesaos/$(uid)/pedidos/$(pedidoId))
              )
              || (
                incoming().tipo == 'criacao'
                && incoming().autor == 'cliente'
                && existsAfter(/databases/$(database)/documents/artesaos/$(uid)/pedidos/$(pedidoId))
                && getAfter(/databases/$(database)/documents/artesaos/$(uid)/pedidos/$(pedidoId)).data.criadoEm == request.time
              )
            );
          allow update: if false;
          allow delete: if isValidId(uid) && isValidId(pedidoId) && isValidId(eventoId)
            && isVerifiedOwner(uid)
            && !exists(/databases/$(database)/documents/artesaos/$(uid));
        }
      }
    }
  }
}
